# ---- Local configuration ----
# Per-machine DB credentials: define() any DB_* constant here; config/db_connect.php applies defaults for the rest.
config/db_connect.local.php

# ---- User uploads ----
# Item photos are runtime data, not source. Keep the folder's .htaccess (blocks script execution) and .gitkeep.
public/uploads/*
!public/uploads/.htaccess
!public/uploads/.gitkeep

# ---- Editors & OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs & temp ----
*.log
*.tmp
