# Copy to .env (git-ignored) for Docker. On Railway, set the same names under the app service's Variables.
# Never commit real values.

# Public address of the site, used in emailed links. Must be https:// on a real deploy.
APP_URL=

# ---- System email (verification, password reset, security alerts) ----
# Sent through Brevo's HTTPS API (Railway blocks SMTP). brevo.com → Settings → SMTP & API → API Keys
BREVO_API_KEY=
# A dedicated sender address for system mail, verified in Brevo → Senders, Domains & Dedicated IPs → Senders
MAIL_FROM=
MAIL_FROM_NAME=Cardinal Finds

# Minutes an email verification link stays valid (default 30). Unconfirmed accounts are removed 24 hours after it expires.
EMAIL_VERIFICATION_EXPIRY_MINUTES=30

# ---- Cloudflare Turnstile (CAPTCHA on log-in and registration) ----
# dash.cloudflare.com → Turnstile → Add widget; add your domain (and localhost for testing).
# Left empty locally, Cloudflare's always-pass test keys are used. On Railway they are required:
# without them every log-in and registration is refused.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
