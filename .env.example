# Copy to .env (git-ignored) to send real password-reset emails from Docker.
# On Railway, set the same names under the app service's Variables instead.

# Brevo (brevo.com) → Settings → SMTP & API → API Keys
BREVO_API_KEY=
# A sender address you verified in Brevo → Senders, Domains & Dedicated IPs → Senders
MAIL_FROM=
MAIL_FROM_NAME=CLAFS
